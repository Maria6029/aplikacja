def test_gra_zakonczona_sukcesem_zapisuje_czas_i_poziom(monkeypatch, tmp_path):
"""
Symuluje pomyślne zakończenie rozgrywki. Podstawia fałszywe implementacje
dla pól tekstowych interfejsu, timerów oraz okien, sprawdzając czy metoda wyliczająca
czas przekazuje właściwy poziom trudności i wynik do rankingu.
"""
    plik = tmp_path / "ranking.json"
    zapisane_okna = []

    class FakeLineEdit:
        def text(self):
            return "Olek"

    class FakeRadio:
        def __init__(self, checked=False):
            self._checked = checked

        def isChecked(self):
            return self._checked

    class FakeOknoStartowe:
        lineedit_nazwa_swoja = FakeLineEdit()
        radio_latwy = FakeRadio(False)
        radio_trudny = FakeRadio(True)

    class FakeRankingManager(RankingManager):
        def __init__(self):
            super().__init__(str(plik))

    class FakeRankingOkno:
        def __init__(self, manager, domyslny_poziom="Średni", jezyk="pl", parent=None):
            zapisane_okna.append((manager, domyslny_poziom))

        def exec_(self):
            return 0

    monkeypatch.setattr(Ranking_czasow.timeit, "default_timer", lambda: 142.0)
    monkeypatch.setattr(Ranking_czasow, "RankingManager", FakeRankingManager)
    monkeypatch.setattr(Ranking_czasow, "RankingOkno", FakeRankingOkno)

    Ranking_czasow.gra_zakonczona_sukcesem(FakeOknoStartowe(), czas_startu=100.0)

    manager, poziom = zapisane_okna[0]

    assert poziom == "Trudny"
    assert manager.wyniki["Trudny"]["Olek"] == 42

