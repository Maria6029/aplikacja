from generator import Plansza

# Kompletny, poprawnie rozwiązany ciąg Sudoku używany jako wzorzec w testach
POPRAWNY_KOD = (
    "534678912"
    "672195348"
    "198342567"
    "859761423"
    "426853791"
    "713924856"
    "961537284"
    "287419635"
    "345286179"
)


def kod_na_plansze(kod):
 """Funkcja pomocnicza testu, która konwertuje płaski string znaków na dwuwymiarową listę 9x9 liczb int."""
    return [[int(kod[r * 9 + c]) for c in range(9)] for r in range(9)]


def czy_poprawne_sudoku(kod):
"""
Algorytm walidujący poprawność Sudoku.
Sprawdza unikalność cyfr 1-9 w każdym wierszu, kolumnie oraz podkwadracie 3x3.
"""
    plansza = kod_na_plansze(kod)

    wymagane = set(range(1, 10))

     # 1. Sprawdzenie wierszy
    for wiersz in plansza:
        assert set(wiersz) == wymagane

     # 2. Sprawdzenie kolumn
    for kolumna in range(9):
        assert {plansza[wiersz][kolumna] for wiersz in range(9)} == wymagane

     # 3. Sprawdzenie wszystkich 9 podkwadratów 3x3
    for start_wiersz in range(0, 9, 3):
        for start_kolumna in range(0, 9, 3):
            kwadrat = {
                plansza[w][k]
                for w in range(start_wiersz, start_wiersz + 3)
                for k in range(start_kolumna, start_kolumna + 3)
            }
            assert kwadrat == wymagane


def test_konstruktor_wczytuje_kod_planszy():
"""Sprawdzamy, czy program potrafi zamienić jeden długi ciąg cyfr w czytelną dla komputera planszę do Sudoku"""
    plansza = Plansza(POPRAWNY_KOD)

    assert plansza.plansza[0][0] == 5
    assert plansza.plansza[0][1] == 3
    assert plansza.plansza[8][8] == 9
    assert plansza.plansza_na_kod() == POPRAWNY_KOD


def test_plansza_na_kod_dziala_dla_aktualnej_planszy():
