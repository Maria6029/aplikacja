@pytest.mark.parametrize(
    "trudnosc, oczekiwana_liczba_zer",
    [
        (0, 36),
        (1, 46),
        (2, 52),
    ],
)
def test_generuj_kod_planszy_gry_zwraca_poprawne_kody(trudnosc, oczekiwana_liczba_zer):
    plansza = Plansza()

    kod_gry, kod_rozwiazania = plansza.generuj_kod_planszy_gry(trudnosc)

    assert isinstance(kod_gry, str)
    assert isinstance(kod_rozwiazania, str)

    assert len(kod_gry) == 81
    assert len(kod_rozwiazania) == 81

    assert all(znak in "0123456789" for znak in kod_gry)
    assert all(znak in "123456789" for znak in kod_rozwiazania)

    assert kod_gry.count("0") == oczekiwana_liczba_zer

    czy_poprawne_sudoku(kod_rozwiazania)


@pytest.mark.parametrize("trudnosc", [0, 1, 2])
def test_wygenerowana_plansza_ma_jedno_rozwiazanie(trudnosc):
    plansza = Plansza()

    kod_gry, _ = plansza.generuj_kod_planszy_gry(trudnosc)

    plansza_do_sprawdzenia = Plansza(kod_gry)
    rozwiazania = plansza_do_sprawdzenia.znajdz_liczbe_rozwiazan()

    assert len(rozwiazania) == 1
