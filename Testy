def test_dodaj_wynik_twody_plik_json(tmp_path):
 """
Weryfikuje, czy dodanie nowego wyniku poprawnie zapisuje dane do pliku fizycznego
oraz czy struktura zapisanego pliku JSON jest poprawna.
"""
    plik = tmp_path / "ranking.json"
    manager = RankingManager(str(plik))

    manager.dodaj_wynik("Olek", "Średni", 123)

