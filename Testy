# Testy funkcji tłumaczącej

def test_translate_zwraca_tlumaczenie():
"""
Weryfikuje, czy funkcja translate poprawnie zwraca przetłumaczone frazy
dla obsługiwanych języków (polski, angielski, ukraiński).
"""
    assert translate("pl", "time") == "Czas"
    assert translate("en", "time") == "Time"
    assert translate("ua", "time") == "Час"


def test_translate_zwraca_klucz_gdy_brak_tlumaczenia():
"""
Sprawdza czy jeśli klucz lub język nie istnieje, to
funkcja zwraca przekazany klucz jako tekst domyślny.
"""
    assert translate("pl", "nie_istnieje") == "nie_istnieje"
    assert translate("xx", "time") == "time"

