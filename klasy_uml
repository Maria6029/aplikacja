@startuml
set namespaceSeparator none
skinparam classAttributeIconSize 0

' Podstawowe klasy z PyQt5 używane do dziedziczenia
class QMainWindow
class QLineEdit
class QDialog

' Logika generowania i sprawdzania planszy (z generator.py)
class Plansza {
  + plansza : List[List[int]]
  + rozwiazana_plansza : List[List[int]]
  --
  + __init__(kod : str = None)
  + czy_rozwiazana() : bool
  + pobierz_bledy() : Set[Tuple[int, int]]
  + sprawdz_pole(liczba : int, wspolrzedne : Tuple[int, int]) : bool
  + generuj_plansze_gry(trudnosc : int) : Tuple[List, List]
  + generuj_kod_planszy_gry(trudnosc : int) : Tuple[str, str]
  - __generuj_losowa_plansze() : List[List[int]]
}

' Pojedyncza komórka na siatce sudoku
class SudokuCell {
  + fokus_otrzymany : pyqtSignal
  + row : int
  + col : int
  + wartosc : str
  + notatki : Set[str]
  + wygenerowane : bool
  + odgadnieta : bool
  + czy_bledna : bool
  --
  + __init__(row, col, glowne_okno, parent=None)
  + focusInEvent(event)
  + keyPressEvent(event)
  + ustaw_poczatkowa(val)
  + odswiez_tekst()
}

' Główne okno zarządzające ekranami gry i menu
class GlowneOkno {
  + stos_ekranow : QStackedWidget
  + ekran_menu : QWidget
  + ekran_gry : QWidget
  + lineedit_nazwa_swoja : QLineEdit
  + radio_latwy : QRadioButton
  + radio_sredni : QRadioButton
  + radio_trudny : QRadioButton
  + etykieta_zycia : QLabel
  + etykieta_czasu : QLabel
  + stoper : QTimer
  + gra_zakonczona : bool
  + akt_wiersz : int
  + akt_kolumna : int
  --
  + __init__()
  + wycentruj_okno()
  + uruchom_gre()
  + podswietl_obszary(klik_wiersz, klik_kolumna)
  + odswiez_obecne_podswietlenie()
  + sprawdz_stan_gry()
}

' Zarządzanie plikiem JSON i wynikami graczy
class RankingManager {
  + plik_bazy : str
  + wyniki : dict
  --
  + __init__(nazwa_pliku="ranking.json")
  + wczytaj_ranking() : dict
  + zapisz_ranking()
  + dodaj_wynik(imie, poziom, czas_sekundy)
  + pobierz_posortowany_ranking(poziom) : list
}

' Okno dialogowe wyświetlające tabele z wynikami
class RankingOkno {
  + domyslny_poziom : str
  + jezyk : str
  + tabele_widzety : dict
  + zakladki : QTabWidget
  --
  + __init__(manager, domyslny_poziom, jezyk, parent=None)
  + initUI()
  + formatuj_czas(sekundy) : str
  + odswiez_wszystkie_tabele()
}

' Nasze komponenty dziedziczą z bazowych klas PyQt5
SudokuCell --|> QLineEdit
GlowneOkno --|> QMainWindow
RankingOkno --|> QDialog

' Powiązania wewnątrz głównego okna gry
GlowneOkno *-- "1" Plansza : plansza
GlowneOkno *-- "81" SudokuCell : komorki
SudokuCell --> "1" GlowneOkno : glowne_okno

' Przepływ danych dla systemu rankingu
GlowneOkno ..> RankingOkno : otwiera po wygranej
RankingOkno --> "1" RankingManager : manager
@enduml
