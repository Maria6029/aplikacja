@startuml SudokuFullDiagram
set namespaceSeparator none


- KLASY GŁÓWNEJ GRY


class "SudokuCell" as SudokuCell {
  fokus_otrzymany
  row
  col
  glowne_okno
  wartosc
  notatki
  wygenerowane

  __init__(row, col, glowne_okno, parent=None)
  focusInEvent(event)
  keyPressEvent(event)
  ustaw_poczatkowa(val)
  odswiez_tekst()
}

class "GlowneOkno" as GlowneOkno {
  stos_ekranow
  ekran_menu
  ekran_gry
  lineedit_nazwa_swoja
  radio_latwy
  radio_sredni
  radio_trudny
  przycisk_start
  checkbox_notatki
  siatka_gry
  komorki
  akt_wiersz
  akt_kolumna

  __init__()
  initUI()
  initGraUI()
  uruchom_gre()
  ustaw_styl_komorki(komorka, r, c, kolor_tla)
  odswiez_obecne_podswietlenie()
  podswietl_obszary(klik_wiersz, klik_kolumna)
}

class "Board" as Board {
  board
  generateQuestionBoardCode(trudnosc)
}



- KLASY RANKINGU


class "RankingManager" as RankingManager {
  plik_bazy
  wyniki

  __init__(plik_bazy="ranking.json")
  wczytaj_ranking()
  zapisz_ranking()
  dodaj_wynik(imie, poziom, czas_sekundy)
  pobierz_posortowany_ranking(poziom)
}

class "RankingOkno" as RankingOkno {
  manager
  domyslny_poziom
  tabele_widzety
  zakladki

  __init__(manager, domyslny_poziom="Średni", parent=None)
  initUI()
  formatuj_czas(sekundy)
  odswiez_wszystkie_tabele()
}

class "FunkcjePomocnicze" as FunkcjePomocnicze <<utility>> {
  rgb(r, g, b)
  gra_zakonczona_sukcesem(okno_startowe, czas_startu)
}



